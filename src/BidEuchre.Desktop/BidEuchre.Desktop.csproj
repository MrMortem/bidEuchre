<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BidEuchre</AssemblyName>
    <RootNamespace>BidEuchre.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BidEuchre.Desktop.Tests" />
    <ProjectReference Include="../BidEuchre.App/BidEuchre.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="../../assets/pixel/*.png" Link="Pixel/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../assets/pixel/campaign-placeholders/joker/*.png" Link="Pixel/campaign/joker/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../assets/pixel/campaign-placeholders/tarot/*.png" Link="Pixel/campaign/tarot/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../assets/pixel/campaign-placeholders/gumball/*.png" Link="Pixel/campaign/gumball/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../assets/pixel/campaign-placeholders/sigil/*.png" Link="Pixel/campaign/sigil/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../assets/pixel/Pixel.ttf" Link="Pixel/Pixel.ttf" />
    <None Include="../../assets/pixel/FONT-LICENSE.txt" Link="Pixel/FONT-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../bid-euchre-final-rules.md" Link="bid-euchre-final-rules.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
